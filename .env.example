DATABASE_URL=postgres://billing:change-me@localhost:5432/billing?sslmode=verify-full
LISTEN_ADDR=:8080
SESSION_SECRET=replace-with-at-least-32-random-bytes
DSTACK_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes
DSTACK_URL=https://dstack.example.com
DSTACK_ADMIN_TOKEN=provisioning-only-admin-token
DSTACK_CUSTOMER_TOKEN_MODE=admin_refresh
PROVIDER_BACKENDS_FILE=./provider-backends.yml
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_STATUS_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=replace-me
MIDTRANS_CLIENT_KEY=replace-me
PUBLIC_BASE_URL=https://billing.example.com
# Google OAuth client for portal sign-in. The redirect URL must be the portal callback, registered verbatim in the Google console.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=https://billing.example.com/api/auth/google/callback
# Comma-separated CIDR ranges of reverse proxies whose X-Forwarded-For header the backend trusts. Leave empty when no proxy sits in front of the backend.
TRUSTED_PROXY_CIDRS=
