POSTGRES_SUPERUSER_PASSWORD=replace-with-hex-secret
BILLING_DB_PASSWORD=replace-with-hex-secret
DSTACK_DB_PASSWORD=replace-with-hex-secret
DSTACK_ADMIN_TOKEN=replace-with-hex-secret
SESSION_SECRET=replace-with-at-least-32-bytes-of-hex
DSTACK_ENCRYPTION_KEY=replace-with-exactly-32-bytes-of-hex
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
MIDTRANS_BASE_URL=
MIDTRANS_STATUS_URL=
PUBLIC_BASE_URL=https://billing.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=billing@example.com
PROVIDER_ADMIN_EMAIL=provider@example.com
BACKEND_HTTP_PORT=8080
DSTACK_HTTPS_PORT=8443
DSTACK_IMAGE=dstackai/dstack:0.22.7
POSTGRES_IMAGE=postgres:16
CADDY_IMAGE=caddy:2.11-alpine
DSTACK_CUSTOMER_TOKEN_MODE=admin_refresh
